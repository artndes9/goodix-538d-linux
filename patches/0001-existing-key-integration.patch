@@ -0,0 +1,83 @@
+/* Existing-key support; SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "goodix_psk.h"
+#include <gio/gio.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <openssl/crypto.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+gboolean goodix_psk_load(const char *path, guint8 key[GOODIX_PSK_SIZE], GError **error)
+{
+    guint8 input[GOODIX_PSK_SIZE + 1] = {0};
+    struct stat st;
+    gsize used = 0;
+    gboolean ok = FALSE;
+    int fd;
+    OPENSSL_cleanse(key, GOODIX_PSK_SIZE);
+    if (!path || !g_path_is_absolute(path)) {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+                            "Existing PSK requires an absolute file path");
+        return FALSE;
+    }
+    fd = open(path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK);
+    if (fd < 0) {
+        g_set_error_literal(error, G_IO_ERROR, g_io_error_from_errno(errno),
+                            "Cannot open private existing-PSK file");
+        return FALSE;
+    }
+    if (fstat(fd, &st) != 0 || !S_ISREG(st.st_mode) ||
+        (st.st_uid != 0 && st.st_uid != geteuid()) ||
+        (st.st_mode & 07777) != 0600 || st.st_nlink != 1 ||
+        st.st_size != GOODIX_PSK_SIZE) {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED,
+                            "PSK must be a private 0600 regular file containing exactly 32 raw bytes");
+        goto out;
+    }
+    while (used < sizeof(input)) {
+        ssize_t n = read(fd, input + used, sizeof(input) - used);
+        if (n < 0 && errno == EINTR) continue;
+        if (n < 0) {
+            g_set_error_literal(error, G_IO_ERROR, g_io_error_from_errno(errno),
+                                "Cannot read existing-PSK file");
+            goto out;
+        }
+        if (n == 0) break;
+        used += n;
+    }
+    if (used != GOODIX_PSK_SIZE) {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                            "PSK file changed or has incorrect length");
+        goto out;
+    }
+    guint8 nonzero = 0;
+    for (gsize i = 0; i < GOODIX_PSK_SIZE; i++) nonzero |= input[i];
+    if (!nonzero) {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                            "Existing-key mode rejects an all-zero PSK");
+        goto out;
+    }
+    memcpy(key, input, GOODIX_PSK_SIZE);
+    ok = TRUE;
+out:
+    close(fd);
+    OPENSSL_cleanse(input, sizeof(input));
+    return ok;
+}
+
+gboolean goodix_psk_matches(const guint8 key[GOODIX_PSK_SIZE], const guint8 *digest, gsize length)
+{
+    guint8 expected[GOODIX_PSK_SIZE];
+    gsize size = sizeof(expected);
+    GChecksum *checksum;
+    gboolean matches;
+    if (!digest || length != sizeof(expected)) return FALSE;
+    checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    g_checksum_update(checksum, key, GOODIX_PSK_SIZE);
+    g_checksum_get_digest(checksum, expected, &size);
+    matches = size == sizeof(expected) && CRYPTO_memcmp(expected, digest, sizeof(expected)) == 0;
+    g_checksum_free(checksum);
+    OPENSSL_cleanse(expected, sizeof(expected));
+    return matches;
+}
